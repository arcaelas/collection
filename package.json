{
  "author": {
    "email": "comunity@arcaelas.com",
    "name": "Arcaelas Insiders",
    "url": "https://github.com/arcaelas"
  },
  "bugs": {
    "email": "community@arcaelas.com",
    "url": "https://github.com/arcaelas/collection/issues"
  },
  "dependencies": {
    "@arcaelas/utils": "^2.0.8",
    "lodash": "^4.17.21"
  },
  "description": "Searching, filtering and mapping collections is the bread and butter for developers, that's why we offer you \"eloquent\".",
  "devDependencies": {
    "@types/lodash": "^4.14.194",
    "@types/node": "^24.8.1",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.0.4"
  },
  "files": [
    "build"
  ],
  "homepage": "https://github.com/arcaelas/collection",
  "keywords": [
    "collect",
    "collection",
    "object",
    "arcaelas",
    "@arcaelas",
    "framework",
    "open source",
    "database"
  ],
  "license": "MIT",
  "main": "./build/cjs/index.js",
  "name": "@arcaelas/collection",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/arcaelas/collection.git"
  },
  "scripts": {
    "build": "rm -rf build && tsc --module commonjs --moduleResolution node --outDir build/cjs && tsc-alias --outDir build/cjs && echo '{\"type\":\"commonjs\"}' > build/cjs/package.json && tsc --module ESNext --moduleResolution bundler --outDir build/esm && tsc-alias --resolve-full-paths --outDir build/esm && echo '{\"type\":\"module\"}' > build/esm/package.json",
    "docs": "mkdocs gh-deploy --force",
    "release": "npm publish --access public",
    "prepublishOnly": "yarn build"
  },
  "version": "2.5.3",
  "types": "./build/esm/index.d.ts",
  "module": "./build/esm/index.js",
  "exports": {
    ".": {
      "types": "./build/esm/index.d.ts",
      "import": "./build/esm/index.js",
      "require": "./build/cjs/index.js"
    }
  }
}
